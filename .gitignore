# build artifacts (root workspace + standalone benchmarks crate)
target/

# optional local svod checkout for svod-side development (the dependency
# comes from git; a plain clone builds without it)
/svod

# session / editor artifacts
.zcode/
.claude/
.DS_Store

# secrets + licensed/PII-bearing source lists (internal use only, never ship)
.env
platforms.csv

# data pipeline: downloads, caches, generated mixes — all rebuildable
# (mix splits are also published to the HF dataset repo)
train/cache/
train/data*/
train/tatoeba/
train/.venv/
__pycache__/
*.pyc
*.tar.bz2

# trained-model artifacts: published on Hugging Face, or produced locally
# by spellman-train train — never tracked
/model/
/model-*/

# local training outputs (models, eval TSVs) — artifacts, not source
train/model*/
